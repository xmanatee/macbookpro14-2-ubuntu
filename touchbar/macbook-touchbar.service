[Unit]
ConditionVirtualization=false
Description=Local MacBook Touch Bar hardware status
After=local-fs.target systemd-modules-load.service systemd-udevd.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=notify
ExecStartPre=/usr/bin/python3 -B /opt/macbook-touchbar/hardware.py display
ExecStart=/usr/bin/python3 -B /opt/macbook-touchbar/panel.py
ExecStopPost=/usr/bin/python3 -B /opt/macbook-touchbar/hardware.py keyboard
Restart=on-failure
RestartSec=5
WatchdogSec=15
WatchdogSignal=SIGKILL
TimeoutStartSec=45
TimeoutStopSec=15
RuntimeDirectory=macbook-touchbar
RuntimeDirectoryMode=0700
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_SYS_MODULE CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
InaccessiblePaths=-/etc/NetworkManager/system-connections -/var/lib/tailscale -/var/lib/docker -/run/docker.sock
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-hidraw r
DeviceAllow=char-usb_device rw
DeviceAllow=/dev/uinput rw
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
