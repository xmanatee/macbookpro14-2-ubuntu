# T1 EmbeddedOS exposes Touch Bar and camera through USB configuration 1.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8600", ATTR{bConfigurationValue}="1"
ACTION=="add|bind|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8600", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1", ATTR{power/control}="on"
