DPkg::Lock::Timeout "300";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "false";
// Driver/source ordering and physical boot acceptance belong to attended updates.
Unattended-Upgrade::Package-Blacklist {
    "^linux-(image|headers|modules|generic|source|tools|cloud-tools|firmware)";
    "^dkms$";
    "^grub";
    "^shim";
    "^dracut";
    "^initramfs-tools";
    "^intel-microcode$";
};
